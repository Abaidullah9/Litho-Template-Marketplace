# Template Marketplace — environment template
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# Values come from your Supabase project: Settings → API.

# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Public anon key. Safe to expose to browsers: row level security only lets it
# read published marketplace data. The marketplace UI loads the generated
# registry instead, but scripts accept it as a fallback credential.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service-role key. Server-side only — the admin API and the scripts are the
# only consumers. Never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Postgres connection string (Supabase → Settings → Database).
# Only `npm run db:migrate` needs it, to apply the SQL migrations.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres?sslmode=require

# Admin dashboard: username and password that opens the admin session.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Admin dashboard: secret used to sign session tokens (any long random string).
ADMIN_SESSION_SECRET=CHANGE_ME_A_LONG_RANDOM_SESSION_SECRET

# Server
PORT=8787
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8787
NODE_ENV=development
